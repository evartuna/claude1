# 복사 후 .env 로 저장하여 사용
# cp .env.example .env

# [필수] 세션 암호화 키 - 랜덤 문자열로 반드시 변경
SECRET_KEY=여기에-랜덤-문자열-입력

# [공인IP 사용 시 필수] 학생 폰이 접속할 외부 URL
# 같은 Wi-Fi 환경이면 비워도 됨 (자동 감지)
# 예시:
#   BASE_URL=http://203.0.113.5:5000       ← 공인 IP + 포트
#   BASE_URL=https://attendance.example.com ← 도메인 + HTTPS
BASE_URL=

# QR 코드 기본 유효 시간 (분, 기본 10)
QR_EXPIRY_MINUTES=10
